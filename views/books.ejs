<%- include("partials/header", { title: "Browse books" }) %>
<main class="page-main"><div class="container"><div class="page-intro"><p class="eyebrow">THE BOOKHAVEN COLLECTION</p><h1>Find your next <em>favourite.</em></h1><p>Browse our growing collection of stories, ideas, and inspiration.</p></div><form class="search-bar" method="get" action="/books"><input type="search" name="search" value="<%= search %>" placeholder="Search by title, author, or topic"><select name="category"><option value="">All categories</option><% categories.forEach(item => { %><option value="<%= item.category %>" <%= category === item.category ? "selected" : "" %>><%= item.category %></option><% }) %></select><button class="button" type="submit">Search</button></form><div class="results-meta"><span><strong><%= books.length %></strong> books found</span><% if (search || category) { %><a class="text-link" href="/books">Clear filters</a><% } %></div><div class="book-grid"><% if (!books.length) { %><div class="empty-state"><h2>No books found</h2><p>Try a different search or browse all categories.</p></div><% } else { books.forEach(book => { %><%- include("partials/book-card", { book }) %><% }) } %></div></div></main>
<%- include("partials/footer") %>
