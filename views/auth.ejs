<%- include("partials/header", { title: mode === "login" ? "Sign in" : "Create account" }) %>
<main class="auth-page"><div class="auth-card"><div class="auth-heading"><p class="eyebrow"><%= mode === "login" ? "WELCOME BACK" : "START YOUR JOURNEY" %></p><h1><%= mode === "login" ? "Sign in to BookHaven" : "Create your account" %></h1><p><%= mode === "login" ? "Pick up where you left off." : "Save your favourites and discover more." %></p></div><% if (errors.length) { %><div class="form-errors" role="alert"><% errors.forEach(error => { %><p><%= error %></p><% }) %></div><% } %><form method="post" action="/<%= mode %>" class="form-stack"><% if (mode === "register") { %><label>Full name<input name="name" required minlength="2" value="<%= values.name || '' %>" autocomplete="name"></label><% } %><label>Email address<input type="email" name="email" required value="<%= values.email || '' %>" autocomplete="email"></label><label>Password<input type="password" name="password" required minlength="6" autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>"><small>At least 6 characters</small></label><button class="button full" type="submit"><%= mode === "login" ? "Sign in" : "Create account" %> <span>→</span></button></form><p class="switch-auth"><%= mode === "login" ? "New to BookHaven?" : "Already have an account?" %> <a href="/<%= mode === 'login' ? 'register' : 'login' %>"><%= mode === "login" ? "Create an account" : "Sign in" %></a></p></div></main>
<%- include("partials/footer") %>
