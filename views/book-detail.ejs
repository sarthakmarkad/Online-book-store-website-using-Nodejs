<%- include("partials/header", { title: book.title }) %>
<main class="page-main"><div class="container detail-grid"><div class="detail-cover"><img src="<%= book.cover %>" alt="Cover of <%= book.title %>"></div><div class="detail-copy"><p class="eyebrow"><%= book.category %></p><h1><%= book.title %></h1><p class="detail-author">by <%= book.author %></p><p class="detail-description"><%= book.description %></p><div class="detail-buy"><strong>₹<%= book.price.toFixed(2) %></strong><form action="/cart/add" method="post"><input type="hidden" name="bookId" value="<%= book.id %>"><button class="button" type="submit">Add to cart <span>→</span></button></form></div><button class="reading-list-button" type="button" onclick="alert('Book added to your reading list!')">♡ Add to reading list</button><a class="back-link" href="/books">← Back to collection</a></div></div></main>
<%- include("partials/footer") %>
