<article class="book-card"><a href="/books/<%= book.id %>" class="cover-wrap"><img src="<%= book.cover %>" alt="Cover of <%= book.title %>" loading="lazy"><span class="cover-arrow">↗</span></a><div class="book-info"><p class="book-category"><%= book.category %></p><h3><a href="/books/<%= book.id %>"><%= book.title %></a></h3><p class="author">by <%= book.author %></p><div class="card-bottom"><strong class="price">₹<%= book.price.toFixed(2) %></strong><form action="/cart/add" method="post"><input type="hidden" name="bookId" value="<%= book.id %>"><button class="small-cart-button" type="submit" aria-label="Add <%= book.title %> to cart">+ Cart</button></form></div></div></article>
