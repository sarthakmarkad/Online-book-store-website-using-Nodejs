<%- include("partials/header", { title: "Your cart" }) %>
<main class="page-main"><div class="container"><div class="page-intro"><p class="eyebrow">YOUR BOOKHAVEN CART</p><h1>Books waiting for <em>you.</em></h1><p>Review your selections before you check out.</p></div><% if (!items.length) { %><div class="empty-cart"><div class="empty-cart-icon">🛒</div><h2>Your cart is empty</h2><p>Find a book that belongs in your next chapter.</p><a class="button" href="/books">Browse books <span>→</span></a></div><% } else { %><div class="cart-layout"><section class="cart-items"><div class="cart-toolbar"><strong><%= items.length %> <%= items.length === 1 ? "book" : "books" %></strong><form action="/cart/clear" method="post"><button class="text-button" type="submit">Clear cart</button></form></div><% items.forEach(item => { %><article class="cart-item"><img src="<%= item.cover %>" alt="Cover of <%= item.title %>"><div class="cart-item-info"><p class="book-category"><%= item.category %></p><h2><a href="/books/<%= item.id %>"><%= item.title %></a></h2><p class="author">by <%= item.author %></p><strong class="price">₹<%= item.price.toFixed(2) %></strong></div><div class="cart-item-actions"><form action="/cart/update" method="post" class="quantity-form"><input type="hidden" name="bookId" value="<%= item.id %>"><label for="quantity-<%= item.id %>">Qty</label><input id="quantity-<%= item.id %>" type="number" name="quantity" min="1" max="99" value="<%= item.quantity %>" onchange="this.form.submit()"></form><form action="/cart/remove" method="post"><input type="hidden" name="bookId" value="<%= item.id %>"><button class="text-button remove-button" type="submit">Remove</button></form></div><strong class="line-total">₹<%= (item.price * item.quantity).toFixed(2) %></strong></article><% }) %></section><aside class="cart-summary"><p class="eyebrow">ORDER SUMMARY</p><div><span>Subtotal</span><strong>₹<%= total.toFixed(2) %></strong></div><div><span>Delivery</span><strong class="free">FREE</strong></div><hr><div class="summary-total"><span>Total</span><strong>₹<%= total.toFixed(2) %></strong></div><button class="button full" type="button" onclick="alert('Checkout will be available soon!')">Proceed to checkout <span>→</span></button><a class="continue-shopping" href="/books">← Continue shopping</a></aside></div><% } %></div></main>
<%- include("partials/footer") %>
